# VulNova Observatory — environment configuration
# Copy this file to ".env" and fill in your keys. The .env file is gitignored.
# All keys are OPTIONAL — VulNova works without them, but keys raise rate limits
# and unlock richer data.

# NVD API key (https://nvd.nist.gov/developers/request-an-api-key)
# Higher NVD rate limits for the CVE catalog.
NVD_API_KEY=

# CVEfeed.io API key (https://cvefeed.io) — richer CVE details.
CVEFEED_API_KEY=

# Ransomware.live Pro API key (https://www.ransomware.live/api) — links
# ransomware groups to the CVEs they exploit (shown on the CVE page).
RANSOMWARE_LIVE_API_KEY=

# GitHub token (optional) — raises GitHub API limits for PoC/advisory lookups.
GITHUB_TOKEN=
